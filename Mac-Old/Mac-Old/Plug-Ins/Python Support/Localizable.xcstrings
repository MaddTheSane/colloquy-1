    "PyObjC Required" : {
      "comment" : "PyObjC required error title",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PyObjC が必要です"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 PyObjc"
          }
        }
