    },
    "PyObjC was not found. The Python console and any Python plugins will not work during this session. For the latest version of PyObjC visit http://pyobjc.sourceforge.net." : {
      "comment" : "PyObjC required error message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PyObjC was not found. The Python console and any Python plugins will not work during this session. For the latest version of PyObjC visit https://pyobjc.sourceforge.net."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PyObjC が見つかりませんでした。Python コンソールと Python プラグインはこのセッション中は動作しません。PyObjC の最新バージョンを手に入れるには http://pyobjc.sourceforge.net/ を訪れてください。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 PyObjC。因此您無法使用 Python 主控台以及 Python 外掛程式，要取得最新版本的 PyObjC ，請瀏覽 http://pyobjc.sourceforge.net 網站。"
          }
        }
      }
    },
    "Python Script Changed" : {
      "comment" : "Python script file changed dialog title",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python スクリプトが変更されました"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 工序指令已修改"
          }
        }
      }
    },
    "Python Script Error" : {
      "comment" : "Python script error title",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python スクリプトのエラー"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 工序指令錯誤"
          }
        }
      }
    },
    "Reload" : {
      "comment" : "reload button title",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再読込"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新載入"
          }
        }
      }
    },
    "The Python script \"%@\" had an error while calling the \"%@\" function.\n\n%@" : {
      "comment" : "Python script plugin error message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Python script “%1$@” had an error while calling the “%2$@” function.\n\n%3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python スクリプト「%1$@」は関数「%2$@」の呼び出し中にエラーが起きました。\n\n%3$@"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 工序指令 \"%1$@\" 在呼叫 \"%2$@\" 函式的時候發生錯誤。\n"
          }
        }
      }
    },
    "The Python script \"%@\" had an error while loading.\n\n%@" : {
      "comment" : "Python script error message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Python script “%1$@” had an error while loading.\n\n%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python プラグイン「%1$@」は読み込み中にエラーが起こりました。\n\n%2$@"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在載入 Python 工序指令 \"%1$@\" 時發生錯誤。\n\n%2$@"
          }
        }
      }
    },
    "The Python script \"%@\" has changed on disk. Any script variables will reset if reloaded." : {
      "comment" : "Python script changed on disk message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Python script “%@” has changed on disk. Any script variables will reset if reloaded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python プラグイン「%@」はディスク上で変更されています。再読込を行った場合、スクリプトの変数はリセットされます。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟上的 Python 工序指令 \"%@\" 已經經過修改。這個工序指令使用的變數都會在重新載入後被重設。"
          }
        }
      }
    },
    "Unknown Error" : {
      "comment" : "unknown error",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不明なエラー"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不詳的錯誤"
          }
        }
      }
    }
  },
  "version" : "1.1"
