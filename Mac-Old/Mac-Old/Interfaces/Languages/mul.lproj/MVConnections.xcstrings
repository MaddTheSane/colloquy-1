    "100829.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This nickname is registered and protected. If it is your registered nickname, type your password. Otherwise, please choose a different nickname.\"; ObjectID = \"100829\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This nickname is registered and protected. If it is your registered nickname, type your password. Otherwise, please choose a different nickname."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このニックネームは登録済みで保護されています。あなたが登録したニックネームであれば、パスワードを入力してください。そうでなければ、違うニックネームを選んでください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze bijnaam is geregistreerd en beveiligd. Voer uw wachtwoord in indien deze van u is. Indien dit niet het geval is, kies a.u.b. een nieuwe bijnaam."
          }
        }
      }
