    "833.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Esta alcunha está registada e protegida. Se é a sua alcunha registada, escreva a sua password. Caso contrário, por favor escolha uma alcunha diferente.\"; ObjectID = \"833\";",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Spitzname ist registriert und geschützt. Falls Sie diesen Spitznamen registriert haben, geben Sie bitte Ihr Kennwort ein. Ansonsten wählen Sie bitte einen anderen Spitznamen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este apodo está registrado y protegido. Si este es tu apodo registrado, escribe tu contraseña. De otro modo, elige otro apodo diferente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce pseudonyme est enregistré et protégé. Si c'est votre pseudonyme, tapez votre mot de passe. Dans le cas contraire, merci de changer de pseudonyme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo soprannome è registrato e protetto. Se è il tuo soprannome registrato, immetti la parola d'ordine. Altrimenti, per favore trova un soprannome diverso."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kallenavnet er registrert og beskyttet. Hvis det er ditt, skriv inn passordet. Hvis ikke, venligst velg et annet kallenavn."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta alcunha está registada e protegida. Se é a sua alcunha registada, escreva a sua password. Caso contrário, por favor escolha uma alcunha diferente."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您所使用的代號已經註冊並且受到保護。如果這是您所註冊的代號，請輸入您的密碼。不然，請輸入其他的代號。"
          }
        }
      }
    },
