  "strings" : {
    "54.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Below are the changes that have been made since your version of the software.\"; ObjectID = \"54\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unten stehen alle Veränderungen, die seit ihrer Version der Software vorgenommen wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Below are the changes that have been made since your version of the software."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación se encuentran los cambios realizados desde la versión que se está ejecutando actualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci-dessous, les changements qui ont étés effectués depuis votre version de Colloquy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In seguito puoi trovare i cambiamenti fatti dalla versione dl software che hai in uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいバージョンのソフトから変更される項目を以下に示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under kan du se endringene gjort etter din versjon av programmet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De update bevat onderstaande verbeteringen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo estão as mudanças que foram feitas desde a sua versão do software."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請注意新版軟體與您目前使用版本之間的差異"
          }
        }
      }
    },
