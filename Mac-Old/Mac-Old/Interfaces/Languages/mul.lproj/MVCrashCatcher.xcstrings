    "26.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"%@ encountered an unrecoverable error during a previous session. Please enter any details you may recall about what you were doing when the application crashed. This will help us to improve future releases of %@.\\n\"; ObjectID = \"26\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bei der letzten Benutzung von %@ ist ein schwerer Fehler aufgetreten. Bitte beschreiben Sie so gut wie möglich, was sie getan haben, als das Programm abgestürzt ist, damit %@ weiter verbessert werden kann.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ encountered an unrecoverable error during a previous session. Please enter any details you may recall about what you were doing when the application crashed. This will help us to improve future releases of %2$@.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ha encontrado un error fatal durante una sesión anterior. Por favor comunique que estaba haciendo cuando la aplicación se interrumpió. Esto nos ayudará a mejorar versiones futuras de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a rencontré une erreur qui a du faire quitter le logiciel pendant la session précédente. Veuillez décrire ce que vous faisiez lorsque l'application a quitté. Merci de bien détailler. Ce rapport nous aidera a améliorer les futures versions de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ha riscontrato un errore durante una sessione precedente. Per favore riferisci tutti i dettagli che ti ricordi su quello che stavi facendo quando l'applicazione e' crashata. Questo ci aiutera' a migliorare le versioni future di %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "前回のセッション中に %@ は回復不可能なエラーに遭遇しました。アプリケーションがクラッシュした時に何をしていたかを、覚えている限り詳しく英語で入力してください。%@ の将来のリリースにおいて改善される手助けになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ fant en uopprettelig feil under forrige sesjon. Vennligst skriv inn det du husker fra når programmet kræsjet. Dette vil hjelpe oss i forbedringen i nye versjoner av %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het programma %@ is onverwacht gestopt tijdens een vorige sessie. Beschrijf wat u aan het doen was toen het probleem zich voordeeed. U rapport helpt ons bij het verbeteren van %@.\n"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ encontrou um erro irrecuperável durante uma sessão anterior. Por favor introduza quaisquer detalhes de que se lembre sobre o que fazia quando a aplicação falhou. Isto ajudar-nos-á a melhorar as futuras versões do %@."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 在之前的執行過程中，遇到了一項沒有發現過的錯誤。如果您還記得當機的時候是出了什麼狀況，請在這裡告訴我們。這樣可以幫助我們改善下一版的 %@ 。"
          }
        }
      }
    },
