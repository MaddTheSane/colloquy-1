    "4jp-UJ-tUu.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Also available by pressing F5 while typing.\\nNickname tab completion is supported without this preference.\"; ObjectID = \"4jp-UJ-tUu\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch verfügbar durch Drücken von F5. Spitznamenvervollständigung durch Tabulator ist auch ohne diese Einstellung aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Also available by pressing F5 while typing.\nNickname tab completion is supported without this preference."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También disponible pulsando F5 mientras escribes.\nEl completado del nick con el tabulador está soportado sin esta preferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi disponible en appuyant sur la touche F5 lors de la frappe.\nNickname tab completion is supported without this preference."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche disponibile premendo F5 mentre si sta scivendo.\nIl compleatamento del soprannome è supportato a prescindere da questa preferenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力中に F5 を押す事でも利用可能です。\nこの環境設定を行わなくてもタブキーによるニックネーム補完はサポートされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또한 타이핑중 F5를 누르실수 있습니다\n별명 탭은 완성은 설정에서 허용안해도 지원합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Også tilgjengelig ved å trykke F5 mens du skriver.\nFullføring av kallenavn med Tab er også støttet uten denne preferansen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt ook op F5 drukken tijdens het typen.\nHet vervolledigen van bijnamen wordt ook ondersteund zonder deze instelling."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também disponível carregando em F5 enquanto escreve. Esta preferência suporta completar alcunhas carregando na tecla Tab."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在打字的時候，也可以按下 F5 進行文字自動完成。而就算您不在這裡做任何設置，也可以用 Tab 按鍵，將局部的文字自動拼成使用者的代號。"
          }
        }
      }
    },
