    "dc5-nK-lqg.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Automatically sends messages that begin with common action verbs as actions\"; ObjectID = \"dc5-nK-lqg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt Nachrichten, die mit einem bekannten Verb beginnen, als Aktionen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatically sends messages that begin with common action verbs as actions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar mensajes que comienzan con verbos comunes de acción automáticamente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer automatiquement les messages qui commençent par un verbe d'action communs comme étant une action"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manda automaticamente dei messaggi che iniziano con verbi di azioni comuni come azioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかの動詞で始まるメッセージは自動的にアクションとして送信されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행동에 대한 공통 행동 동사를 자동으로 보냅니"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sender automatisk beskjeder som begynner med vanlige handlingsverb som handling"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzend berichten die beginnen met courante Engelse werkwoorden als acties"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia automaticamente mensagens que comecem com verbos de acção comuns como uma acção"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您的句子是以某些動詞開頭，就會自動將這個句子判斷成是一個動作。"
          }
        }
      }
    },
