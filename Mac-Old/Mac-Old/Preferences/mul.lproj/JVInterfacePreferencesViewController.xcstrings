    "Hkt-sW-eRK.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Panels will be grouped in windows based on the rule sets below.\\nA new window will be opened if no rule sets apply.\"; ObjectID = \"Hkt-sW-eRK\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panels werden, basierend auf den Regelwerken unten, in Fenster gruppiert.\nWenn kein Regelwerk zutrifft, wird ein neues Fenster geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panels will be grouped in windows based on the rule sets below.\nA new window will be opened if no rule sets apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panels will be grouped in windows based on the rule sets below.\nA new window will be opened if no rule sets apply."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panels will be grouped in windows based on the rule sets below.\nA new window will be opened if no rule sets apply."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pannelli saranno raggruppati in finestre in base alle azioni qui impostate.\nSe non sarà trovata corrispondenza con nessuna azione, sarà aperta una nuova finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下のルールセットに基づいてパネルをウインドウにグループ化します。\nルールセットに当てはまらなかった場合は新しいウインドウが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패널들은 아래 규칙 세트를 기반으로 하여 그룹을 짓습니다.\n규칙이 없다면 새 창이 열리게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel vil bli gruppert i vinduer, basert på reglene under.\nEt nytt vindu vil bli åpnet hvis ingen regler gjelder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panelen zullen gegroepeerd worden in vensters op basis van onderstaande regels.\nIndien er geen regels gespecifieerd zijn, zal er een nieuw venster geopend worden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os painéis serão agrupados em janelas segundo os conjuntos de regras abaixo descritas.\nSe nenhuma regra se aplicar abrir-se-á uma nova janela."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統將會根據您在此所做的設置，將控制板組成群組。\n而如果沒有可以套用的規則，系統就會以開啟新視窗的方式，顯示新的控制板。"
          }
        }
      }
    },
