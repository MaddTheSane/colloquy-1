    "qco-MY-Hl2.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"…and keep on screen until activated\"; ObjectID = \"qco-MY-Hl2\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
