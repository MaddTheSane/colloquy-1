          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…y mantenerlo en pantalla hasta activarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…garder à l'écran jusqu'à l'activation"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…e mantienilo sullo schermo finché attivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…アクティブになるまで表示し続ける"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…활성화 될때까지 스크린에 띄우기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…og behold på skjermen til den blir aktivert"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…en toon tot Colloquy op de voorgrond is"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…e deixá-la no ecrã até que seja activada"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…而且在將移回前景前，都一直保持在螢幕上。"
          }
        }
      }
    },
    "wu5-IV-6xo.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Messages containing any of your typed words will be highlighted (if the active style supports highlights).\"; ObjectID = \"wu5-IV-6xo\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten, die eines dieser Wörter enthalten, werden hervorgehoben (falls der ausgewählte Stil das unterstützt)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Messages containing any of your typed words will be highlighted (if the active style supports highlights)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes contenedores de cualquiera de las palabras escritas serán resaltados (si el estilo activo soporta el resalte)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages contenant n'importe lequel des mots ci-dessus seront highlightés (si le thème utilisé supporte le highlight)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi che contengono una qualsiasi delle parole che hai immesso verranno evidenziate (se lo stile corrente supporta l'evidenziatura)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半角スペースで区切って単語を入力してください。これらの単語が一つでも含まれるメッセージは、すべてハイライトされます（アクティブなスタイルがハイライトをサポートしている時のみ）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지에서 여러분이 추가한 모든 단어가 하이라이트 될 것입니다\n(만약 스타일이 하이라이트를 지원한다면 말이죠)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskjeder som inneholder noen av dine innskrevne ord vil bli framhevet (hvis den aktive stilen støtter framheving)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berichten welke een of meerdere van deze woorden bevatten zullen aangeduid worden (indien de actieve stijl signalisaties ondersteunt)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens que tiverem qualquer uma das suas palavras escritas serão destacadas (se o estilo actual suportar destaques)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果有人提到您在這裡設定的關鍵字，就會對您發出提示通知。（不過，您所指定的樣式也支援必須這個功能）"
          }
        }
      }
    },
    "wUY-9y-jdb.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"…repeatedly until Colloquy is in the front\"; ObjectID = \"wUY-9y-jdb\";",
