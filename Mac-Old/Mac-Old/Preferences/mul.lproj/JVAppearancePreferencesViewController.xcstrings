    "8ez-8R-0k2.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Some Styles don't honor these settings, and use built-in values.\"; ObjectID = \"8ez-8R-0k2\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Stile ignorieren diese Einstellungen und benutzen eigene Werte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some Styles don't honor these settings, and use built-in values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Styles don't honor these settings, and use built-in values."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques styles n'utilisent pas cette configuration, et utilisent la configuration intégrée du style."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni stili non rispettano queste impostazioni e usano i valori prestabilti per lo stile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかのスタイルはこれらの設定を尊重せず、内蔵されている値を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇몇 스타일은 이 설정대신에 스타일만의 기본 설정을 사용할 것입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen stiler bryr seg ikke om disse innstillingene og bruker istede de innebygde verdiene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige stijlen negeren deze instellingen, en gebruiken ingebouwde waarden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns estilos não honram estas definições e usam os valores incluídos no estilo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些樣式不會使用這裡的設定，而是使用樣式的內建值。"
          }
        }
      }
    },
    "394.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"You are trying to modify a locked style or variant. Would you like to make a new variant based on the current style settings?\"; ObjectID = \"394\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie versuchen eine(n) schreibgeschützte(n) Stil oder Variante zu ändern. Möchten Sie eine neue Variante erstellen, die auf den gegenwärtigen Einstellungen basiert?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You are trying to modify a locked style or variant. Would you like to make a new variant based on the current style settings?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está intentando modificar una variante bloqueada. ¿Quiere hacer una nueva basada en la configuración de estilos actual?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous essayez de modifier un style ou une variante verrouillée. Voulez-vous créer une nouvelle variante basée sur les réglages de style actuels?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai cercando di modificare uno stile bloccato o una variazione. Vuoi fare una nuova variazione dello stile basato sulle impostazioni dello stile corrente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックされたスタイルかバリアントを修正しようとしています。現在のスタイル設定をもとに新しいバリアントを作成しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 잠겨진 스타일이나 혹은 변형을 수정하려고 하십니다. 현재 스타일 세팅을 기초로 한 새로운 변형을 만드시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du prøver å endre en låst stil eller variant. Ønsker du å lage en ny variant basert på den nåværende stilen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U probeert een gesloten stijl of variant aan te passen.  Wenst u een nieuwe variant te creëren, uitgaande van de huidige stijlinstellingen?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está a tentar modificar um estilo ou variante bloqueada. Quer fazer uma nova variante baseada nas definições actuais do estilo?"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您正要修改一個已經鎖定的樣式。您是否打算用目前樣式設定為基礎，建立一個新的樣式呢？"
          }
        }
      }
    },
