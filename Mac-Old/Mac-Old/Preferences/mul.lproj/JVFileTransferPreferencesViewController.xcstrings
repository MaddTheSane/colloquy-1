    "u9L-og-Bev.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Passive transfers allow files to be sent without the need to open up ports in your firewall or router—the receiver will need to.\"; ObjectID = \"u9L-og-Bev\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passive Übertragung ermöglicht es, Dateien zu senden, ohne Ports in Ihrer Firewall oder Ihrem Router zu öffnen — der Empfänger muss dies tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Passive transfers allow files to be sent without the need to open up ports in your firewall or router—the receiver will need to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transferencias pasivas permiten enviar archivos sin requerir puertos abiertos en el router o firewall exceptuando a quien lo reciba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transferts passifs vous permettent d'envoyer des fichiers sans ouvrir d'autres ports dans votre firewall ou votre routeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità passiva permette l'invio di file senza la necessità di modificare le impostazioni del firewall o router—il ricevente invece dovrà impostare il firewall o router."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッシブ転送は、あなた側のファイアウォールやルータのポートを開けることなくファイル送信を可能にします — 当然受信側もです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패시브 전송을 사용하게 되면 수신자의 방화벽이나 라우터의 포트를 열 필요가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv filoverføring tillater at filer blir sendt uten at porter trenger å åpnes i brannmuren eller routeren - mottakeren må gjøre dette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passieve overdrachten zorgen ervoor dat u bestanden kunt verzenden zonder configuratie van poorten in uw firewall of router. De ontvanger moet deze daarentegen wel correct instellen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transferências passivas permitem que ficheiros possam ser enviados sem a necessidade de abrir portos na sua firewall ou router - o destinatário, no entanto, precisará de o fazer."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所謂的「被動式傳輸」（Passive transfers），就是您可以不用打開您的防火牆或路由器的連接埠，就可以傳送檔案—不過，接受檔案的一方，就必須打開連接埠。"
          }
        }
      }
    },
