    "OM2-Wq-fbw.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"“Safe” files include movies, pictures, sounds, PDF and text documents, disk images and other archive formats.\"; ObjectID = \"OM2-Wq-fbw\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sichere“ Dateien sind beispielsweise Filme, Bilder, Töne, PDF- und Textdokumente, Image-Dateien und andere Archive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Safe” files include movies, pictures, sounds, PDF and text documents, disk images and other archive formats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos \"segurose\" comprenden películas, imágenes, sonidos, documentos de texto y PDF, imágenes de disco u otros formatos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers \"fiables\" incluent les séquences, les images, la musique, les documents PDF et textes, ainsi que les images disque et autres archives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file “sicuri” includono filmati, immagini, suoni, PDF e documenti di testo, immagini di dischi e altri formati di archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“安全な” ファイルには、ムービー・ピクチャ・サウンド・PDF・テキスト書類・ディスクイメージ・その他のアーカイブ形式が含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“안전한” 파일에는 영화, 그림, 사운드, PDF 그리고 텍스트 파일, 디스크 이미지와 기타 압축파일이 포함되어 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Sikre filer\" inkluderer filmer, bilder, lyder, PDF- og tekstdokumenter, diskfiler og andre arkivformat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Veilige” bestanden zijn films, afbeeldingen, geluidsbestanden, PDF- en tekstdocumenten, schijfkopieën en andere archiefbestanden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficheiros “Seguros” incluem filmes, imagens, sons, PDF e documentos de texto, imagens de disco e outros formatos de arquivo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所謂「安全」的檔案包括電影、圖片、聲音、 PDF 以及文字檔案、磁碟影像以及其他壓縮檔案。"
          }
        }
      }
    },
