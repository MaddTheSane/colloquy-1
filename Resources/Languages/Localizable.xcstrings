        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette tilkoblingen for %@? Alle tilhørende passord lagret i Nøkkelringen vil bli slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet u zeker dat u de verbinding voor %@ wilt verwijderen? Alle verwante wachtwoorden zullen eveneens gewist worden."
          }
        },
