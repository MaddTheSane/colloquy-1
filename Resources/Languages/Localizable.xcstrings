    "Are you sure you want to delete the connection for %@? Any associated Keychain passwords will also be deleted." : {
      "comment" : "confirm the delete of a connection",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete the connection for %@? Any associated Keychain passwords will also be deleted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etes vous sûr de vouloir effacer la connexion pour %@? Tous les mots de passe associés seront aussi effacés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler cancellare la connessione con %@? Tutte le password associate salvate nel portachiavi saranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当に %@ への接続を削除してもよろしいですか？関連するキーチェーンパスワードも削除されます。"
