        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ endret dette rommet slik at alle kan endre tema."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verleende iedereen het recht om het onderwerp te wijzigen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ endra dette rommet slik at alle kan endra tema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fez com que todos possam mudar o tópico da sala."
