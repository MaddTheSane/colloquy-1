      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat eingestellt, dass jeder das Thema für diesen Raum ändern kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ changed this room to allow anyone to change the topic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ modificó el canal para permitir a cualquier cambiar el tema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a autorisé n'importe qui à changer le sujet."
          }
        },
