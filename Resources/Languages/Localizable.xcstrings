    "%@ encountered an unrecoverable error during a previous session. Please enter any details you may recall about what you were doing when the application crashed. This will help us to improve future releases of %@." : {
      "comment" : "crash message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der letzten Benutzung von %@ ist ein schwerer Fehler aufgetreten. Bitte beschreiben Sie so gut wie möglich, was sie getan haben, als das Programm abgestürzt ist, damit %@ weiter verbessert werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ encountered an unrecoverable error during a previous session. Please enter any details you may recall about what you were doing when the application crashed. This will help us to improve future releases of %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ encontró un error fatal durante la sesión anterior. Por favor comunique cualquier detalle que pueda recordar sobre la actividad realizada cuando la aplicación se interrumpió. Nos ayudará a mejorar nuevas versiones de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a rencontré une erreur lors de l'execution précédente. Veuillez décrire ce que vous faisiez lorsque l'application a quitté. Ce rapport nous aidera a améliorer les futures versions de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha incontrato un errore irrisolvibile durante la sessione precedente. Per favore descrivi quello che stavi facendo prima che l'applicazione si impiantasse. Questo ci aiuterà a migliorare le future versioni di %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のセッション中に %1$@ は回復不可能なエラーに遭遇しました。アプリケーションがクラッシュした時に何をしていたかを、覚えている限り詳しく英語で入力してください。%2$@ の将来のリリースにおいて改善される手助けになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fant en uopprettelig feil under forrige sesjon. Vennligst skriv inn det du husker fra når programmet kræsjet. Dette vil hjelpe oss i forbedringen i nye versjoner av %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het programma %1$@ is onverwacht gestopt tijdens een vorige sessie. Beschrijf wat u aan het doen was toen het probleem zich voordeed. U rapport helpt ons bij het verbeteren van %2$@."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fann ein uoppretteleg feil under førre sesjonen. Ver greid og skriv inn det du hugsar frå når programmet kræsja. Det vil hjelpa oss å gjera nye versjonar av %2$@ betre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ encontrou um erro irrecuperável durante uma sessão anterior. Por favor introduza quaisquer detalhes de que se lembre sobre o que fazia quando a aplicação falhou. Isto ajudar-nos-á a melhorar futuros lançamentos do %2$@."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 在前一次執行的時候發生了不可預期的問題。請試著回想在問題發生的時候是處在怎樣的狀況，愈詳細愈好。這樣可以幫助我們在下一版的 %2$@ 中，改善這個問題。"
          }
        }
      }
    },
    "%@ had voice removed by %@ in %@." : {
