    "The server is disconnected or refusing connections from your computer. Make sure you are connected to the internet and have access to the server." : {
      "comment" : "chat invalid password dialog message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server antwortet nicht oder nimmt keine Verbindungen von Ihrem Computer an. Vergewissern Sie sich, dass Sie mit dem Internet verbunden sind und Zugang zu diesem Server haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server is disconnected or refusing connections from your computer. Make sure you are connected to the internet and have access to the server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server è disconnesso oppure rifiuta la connessione del tuo computer. Assicurati di essere connesso a internet e di avere accesso al server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバへの接続が切断されたか、このコンピュータからの接続が拒否されました。インターネットへの接続とサーバへのアクセス方法を確認してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren er frakoblet eller nekter tilkobling fra din maskin. Sørg for at du er koblet til internett og har tilgang til serveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U bent niet verbonden met de server of deze wijgert verbindingen van uw computer uit. Controleer uw internetverbinding en toegang tot de server."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren er fråkopla eller nektar tilkopling frå maskina di. Syt for at du er kopla til Internett og har tilgang til serveren."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor está desligado ou está a recusar ligações do seu computador. Verifique se está ligado à internet e se tem acesso ao servidor."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器斷線或是拒絕與您的電腦連線。請確定您已經連上網路，而且有可以連到這個伺服器的權限。"
          }
        }
      }
    },
    "The server may be down for maintenance, or the connection was broken between your computer and the server. Check your connection and try again." : {
      "comment" : "connection dropped",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise wird der Server gewartet oder die verbidung zwischen Ihrem Computer und dem Server wurde unterbrochen. Prüfen Sie Ihre verbindung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server may be down for maintenance, or the connection was broken between your computer and the server. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor podría estar inactivo por mantenimiento, o la conexión entre su equipo y el servidor fue cancelada. Compruebe su conexión e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur doit être déconnecté pour maintenance, ou la connexion a été cassée entre votre ordinateur et le serveur. Vérifiez votre connexion et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server potrebbe essere spento per manutenzione, oppure la connessione tra il tuo computer e il server è caduta. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバがメインテナンスのため停止しているか、サーバとの接続が不安定です。接続を確認し、後でもう一度試してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren er kanskje nede for vedlikehold, eller tilkoblingen ble brutt mellom maskinen din og serveren. Sjekk tilkoblingn din og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server is mogelijk stilgelegd voor onderhoud, of de verbinding tussen uw computer en de server is verbroken. Controleer uw verbinding en probeer opnieuw."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren er kanskje nede for vedlikehald, eller tilkoplinga vart broten mellom maskina di og serveren. Sjekk tilkoplinga di og prøv om att."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor poderá estar em baixo para manutenção ou a ligação entre o servidor e o seu computador foi quebrada. Verifique a sua ligação e tente de novo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器可能因為維修而暫時關機，或是您的電腦與伺服器之間的連線中斷。請檢查一下您的連線，然後重試看看。"
          }
        }
      }
    },
