          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du viss på at du vil sletta tilkoplinga for %@? Alle passorda som høyrer i hop og er lagra i Nykkelringen vil bli sletta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
