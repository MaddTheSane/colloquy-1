          }
        }
      }
    },
    "Private messages and highlighted\nroom messages are pushed.\n\nPush notifications require connecting\nto a push aware bouncer." : {
      "comment" : "Push Notification section footer title",
      "extractionState" : "migrated",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private Nachrichten und hervorgehobene\nRaum-Nachrichten werden weitergeleitet („Push“).\n\nHierzu muss mit einem Bouncer mit „Push“-Fähigkeit verbunden werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private messages and highlighted\nroom messages are pushed.\n\nPush notifications require connecting\nto a push aware bouncer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Messaggi Privati, o quelli pubblici che\ncontengono il tuo nick, vengono notificati.\nPerò le notifiche-Push, per funzionare,\nrichiedono una connessione ad un Bouncer\nche sia compatibile con Push."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 메시지와 채널에서 강조된 메시지가 푸쉬 됩니다.\n\n푸쉬는 푸시를 인식하는 바운서에 연결하셔야 사용하실 수 있습니다."
          }
        }
      }
    },
