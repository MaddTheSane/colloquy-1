    "You are currently connecting,\ntry sending again soon." : {
      "comment" : "Can't send message to user because server is connecting alert message",
      "extractionState" : "migrated",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden gerade verbunden,\nversuchen Sie es in Kürze noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are currently connecting,\ntry sending again soon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione in corso,\ninvia nuovamente il messaggio più tardi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 연결중이니,\n조금 기다리셨다가 다시 시도해주세요."
          }
        }
      }
    },
    "You are currently connecting,\nyou should join the room shortly." : {
      "comment" : "Can't send message to room because server is connecting alert message",
