          "stringUnit" : {
            "state" : "translated",
            "value" : "You are currently disconnected,\nreconnect and try again."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sei connesso al momento,\nconnettiti e riprova."
